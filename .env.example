# Supabase content store (server-side only — never expose the service key)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login
# Generate with: node scripts/make-admin-hash.mjs "your-password"
ADMIN_PASSWORD_HASH=salthex:hashhex
# Any long random string, e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me

# Optional: email the owner when a contact-form message arrives (resend.com)
RESEND_API_KEY=
ALERT_EMAIL=owner@example.com
# Optional sender; defaults to onboarding@resend.dev (delivers only to the
# Resend account owner's address until you verify a domain)
RESEND_FROM=
