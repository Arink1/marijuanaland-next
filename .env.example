# Supabase content store (server-side only — never expose the service key)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login
# Generate with: node scripts/make-admin-hash.mjs "your-password"
ADMIN_PASSWORD_HASH=salthex:hashhex
# Any long random string, e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-me
